{
  "name": "tf-studio",
  "productName": "GARASU",
  "version": "1.5.2",
  "description": "GARASU (Glass Aging, Relaxation And Simulation Utility): compute and fit glass relaxation dynamics with structural relaxation models",
  "author": "Wataru Takeda (University of Arizona, Lucas group)",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "sync": "bash sync_apps.sh",
    "dist": "electron-builder --config electron-builder.config.js --mac --publish never",
    "release": "electron-builder --config electron-builder.config.js --mac --publish always",
    "dist:win": "electron-builder --config electron-builder.config.js --win --publish never",
    "release:win": "electron-builder --config electron-builder.config.js --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "homepage": "https://github.com/wtakeda-research/GARASU",
  "repository": {
    "type": "git",
    "url": "https://github.com/wtakeda-research/GARASU.git"
  }
}